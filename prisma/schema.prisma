// Yerel: provider = "sqlite" + DATABASE_URL="file:./dev.db"
// Hostinger MySQL: provider = "mysql", DATABASE_URL panelden; yeni migrate veya db push gerekir.
// Komutlar: npm run build | db:deploy | db:migrate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  category    String?
  description String?
  status      String?
  year        Int?
  location    String?
  /// İngilizce içerik (public /en yolu; boşsa Türkçe alanlara düşülür)
  titleEn       String?
  categoryEn    String?
  descriptionEn String?
  statusEn      String?
  locationEn    String?
  areaM2      Int?
  /// JSON dizi: ["https://.../a.webp","..."]
  imageUrls   String   @db.LongText @default("[]")
  published   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, sortOrder])
  @@index([slug])
  @@index([category])
  @@index([createdAt])
  @@index([updatedAt])
}

model Message {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String
  body      String
  /// Gizlilik: ham IP yerine isteğe bağlı hash
  ipHash    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  /// Kim yaptı? (admin email)
  actor     String
  /// Ne yaptı? (örn: "project.create")
  action    String
  /// Hangi kayıt? (örn: "Project")
  entity    String?
  entityId  String?
  /// Opsiyonel metadata (JSON string)
  meta      String?
  createdAt DateTime @default(now())

  @@index([actor, createdAt])
  @@index([action, createdAt])
  @@index([entity, entityId])
}

model Service {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  shortDescription String?
  heroImageUrl     String?
  /// İngilizce metinler (boşsa /en’de Türkçe kullanılır); görsel/slug ortak
  titleEn              String?
  shortDescriptionEn    String?
  /// JSON: kapsam maddeleri EN — TR ile aynı sıra uzunluğunda tutulur
  scopeEn              String?  @default("[]")
  processEn            String?  @default("[]")
  faqEn                String?  @default("[]")
  /// JSON string: ["..."] — optional for future usage
  scope            String?  @default("[]")
  /// JSON string: [{title,description}, ...]
  process          String?  @default("[]")
  /// JSON string: [{q,a}, ...]
  faq              String?  @default("[]")
  published        Boolean  @default(false)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([published, sortOrder])
  @@index([slug])
  @@index([createdAt])
  @@index([updatedAt])
}

model SiteContent {
  id        String   @id @default(cuid())
  /// e.g. "about", "contact"
  key       String
  /// "tr" | "en"
  locale    String
  /// JSON string payload (CMS metinleri uzun olabilir)
  data      String   @db.LongText @default("{}")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([key, locale])
  @@index([key, locale])
}
