// Supabase Postgres (veya başka Postgres).
// Vercel/app: DATABASE_URL = pooler (6543, pgbouncer)
// Migrate: DIRECT_URL = direct (5432)
// Komutlar: npm run db:generate | db:deploy | db:migrate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  category    String?
  description String?
  status      String?
  year        Int?
  location    String?
  /// İngilizce içerik (public /en yolu; boşsa Türkçe alanlara düşülür)
  titleEn       String?
  categoryEn    String?
  descriptionEn String?
  statusEn      String?
  locationEn    String?
  areaM2      Int?
  /// JSON dizi: ["https://.../a.webp","..."]
  imageUrls   String   @db.Text @default("[]")
  published   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, sortOrder])
  @@index([slug])
  @@index([category])
  @@index([createdAt])
  @@index([updatedAt])
}

model Message {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String
  body      String   @db.Text
  /// Gizlilik: ham IP yerine isteğe bağlı hash
  ipHash    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  /// Kim yaptı? (admin email)
  actor     String
  /// Ne yaptı? (örn: "project.create")
  action    String
  /// Hangi kayıt? (örn: "Project")
  entity    String?
  entityId  String?
  /// Opsiyonel metadata (JSON string)
  meta      String?  @db.Text
  createdAt DateTime @default(now())

  @@index([actor, createdAt])
  @@index([action, createdAt])
  @@index([entity, entityId])
}

model Service {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  shortDescription String?  @db.Text
  heroImageUrl     String?
  /// İngilizce metinler (boşsa /en’de Türkçe kullanılır); görsel/slug ortak
  titleEn              String?
  shortDescriptionEn    String?  @db.Text
  /// JSON: kapsam maddeleri EN — TR ile aynı sıra uzunluğunda tutulur
  scopeEn              String?  @db.Text @default("[]")
  processEn            String?  @db.Text @default("[]")
  faqEn                String?  @db.Text @default("[]")
  /// JSON string: ["..."] — optional for future usage
  scope            String?  @db.Text @default("[]")
  /// JSON string: [{title,description}, ...]
  process          String?  @db.Text @default("[]")
  /// JSON string: [{q,a}, ...]
  faq              String?  @db.Text @default("[]")
  published        Boolean  @default(false)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([published, sortOrder])
  @@index([slug])
  @@index([createdAt])
  @@index([updatedAt])
}

model SiteContent {
  id        String   @id @default(cuid())
  /// e.g. "about", "contact"
  key       String
  /// "tr" | "en"
  locale    String
  /// JSON string payload (CMS metinleri uzun olabilir)
  data      String   @db.Text @default("{}")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([key, locale])
  @@index([key, locale])
}

// --- Client Project Portal (müşteri paneli; portfolyo Project modelinden ayrı) ---

enum ClientProjectStatus {
  PLANNING
  PERMITTING
  CONSTRUCTION
  INTERIOR
  COMPLETED
}

enum ClientStageStatus {
  PENDING
  IN_PROGRESS
  DONE
}

model ClientUser {
  id                 String   @id @default(cuid())
  fullName           String
  username           String   @unique
  email              String?
  phone              String?
  passwordHash       String
  mustChangePassword Boolean  @default(true)
  notifyEmail        Boolean  @default(true)
  notifySms          Boolean  @default(true)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  projects           ClientProjectMember[]
  deliveryRequests   ClientDeliveryRequest[]
  notificationLogs   ClientNotificationLog[]

  @@index([email])
  @@index([active])
  @@index([createdAt])
}

model ClientProject {
  id            String              @id @default(cuid())
  title         String
  address       String?
  status        ClientProjectStatus @default(PLANNING)
  coverImageUrl String?             @db.Text
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  stages           ClientProjectStage[]
  updates          ClientProjectUpdate[]
  members          ClientProjectMember[]
  deliveryRequests ClientDeliveryRequest[]

  @@index([status])
  @@index([createdAt])
}

model ClientProjectMember {
  projectId String
  clientId  String
  project   ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client    ClientUser    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([projectId, clientId])
  @@index([clientId])
}

model ClientProjectStage {
  id            String            @id @default(cuid())
  projectId     String
  project       ClientProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  orderIndex    Int
  status        ClientStageStatus @default(PENDING)
  targetDate    DateTime?
  completedDate DateTime?

  updates ClientProjectUpdate[]

  @@index([projectId, orderIndex])
}

model ClientProjectUpdate {
  id          String    @id @default(cuid())
  projectId   String
  project     ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stageId     String?
  stage       ClientProjectStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  title       String
  body        String    @db.Text
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  media           ClientUpdateMedia[]
  notifications   ClientNotificationLog[]

  @@index([projectId, isPublished, publishedAt])
  @@index([createdAt])
}

model ClientUpdateMedia {
  id                 String @id @default(cuid())
  updateId           String
  update             ClientProjectUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  cloudinaryUrl      String @db.Text
  cloudinaryPublicId String
  mediaType          String
  caption            String?
  orderIndex         Int    @default(0)

  @@index([updateId, orderIndex])
}

model ClientNotificationLog {
  id               String   @id @default(cuid())
  clientId         String
  client           ClientUser @relation(fields: [clientId], references: [id], onDelete: Cascade)
  updateId         String
  update           ClientProjectUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  channel          String
  status           String
  providerResponse String?  @db.Text
  sentAt           DateTime @default(now())

  @@index([updateId, sentAt])
  @@index([clientId, sentAt])
}

model ClientDeliveryRequest {
  id        String   @id @default(cuid())
  projectId String
  project   ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId  String
  client    ClientUser @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String
  address   String   @db.Text
  notes     String?  @db.Text
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([projectId])
  @@index([clientId])
}
